# Runtime
APP_ENV=production
LOG_LEVEL=INFO
POLL_INTERVAL_MINUTES=15
MAX_ARTICLES_PER_RUN=10
REQUEST_TIMEOUT_SECONDS=20

# Sources
RSS_FEED_URL=https://vsin.com/feed/
USER_AGENT=vsin-twitter-pipeline/1.0 (+ops@vsin.com)

# Data store
DATABASE_URL=sqlite:///./pipeline.db

# OpenAI
OPENAI_API_KEY=<SECRET>
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.45
OPENAI_MAX_OUTPUT_TOKENS=600

# Typefully API (v2)
TYPEFULLY_API_BASE=https://api.typefully.com
TYPEFULLY_API_KEY=<SECRET>
TYPEFULLY_SOCIAL_SET_ID=replace-with-typefully-social-set-id
TYPEFULLY_PUBLISH_MODE=draft
# allowed values: draft | schedule | publish_now
TYPEFULLY_SCHEDULE_ISO8601=

# Controls
ENABLE_THREAD_GENERATION=true
DRY_RUN=false
